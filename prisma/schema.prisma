// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ExpenseCategory {
  GROCERIES
  UTILITIES
  RENT
  MAINTENANCE
  TRANSPORT
  HEALTH
  ENTERTAINMENT
  OTHER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  // Profile picture. Cloudinary needs the public ID to delete the file. The URL is stored ready to
  // show, because a person appears inside many other records and none of them has to build it.
  avatarPublicId String?
  avatarUrl      String?
  createdAt DateTime @default(now())

  memberships         HouseholdMember[]
  createdHouseholds   Household[]               @relation("HouseholdCreator")
  createdTasks        Task[]                    @relation("TaskCreator")
  assignedTasks       Task[]                    @relation("TaskAssignee")
  paidExpenses        Expense[]                 @relation("ExpensePayer")
  createdExpenses     Expense[]                 @relation("ExpenseCreator")
  uploadedImages      Image[]
  passwordResets      PasswordReset[]
  notifications       Notification[]
  receivedInvitations HouseholdInvitation[]     @relation("InvitationRecipient")
  sentInvitations     HouseholdInvitation[]     @relation("InvitationSender")
  chatStates          ConversationParticipant[]
  chatMessages        Message[]
  deletedChatMessages Message[]                 @relation("MessageDeletedBy")
  hiddenChatMessages  MessageDeletion[]
  deviceTokens        DeviceToken[]
  chatDeliveries      ChatDelivery[]
  chatReceipts        ChatReceipt[]
}

model Household {
  createdById String
  createdBy   User     @relation("HouseholdCreator", fields: [createdById], references: [id], onDelete: Restrict)
  id          String   @id @default(uuid())
  name        String
  // Household picture, stored the same way as a user's avatar.
  picturePublicId String?
  pictureUrl      String?
  createdAt   DateTime @default(now())

  members       HouseholdMember[]
  tasks         Task[]
  expenses      Expense[]
  images        Image[]
  notifications Notification[]
  invitations   HouseholdInvitation[]
  conversations Conversation[]

  @@unique([createdById, name])
}

model HouseholdMember {
  id          String        @id @default(uuid())
  userId      String
  householdId String
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
}

// A request to join a household that the invited user has not answered yet. The row exists only
// while it is pending: accepting turns it into a membership, and declining or cancelling deletes
// it. That is why the unique pair below means one open invitation per user and household.
model HouseholdInvitation {
  id            String        @id @default(uuid())
  householdId   String
  invitedUserId String
  invitedById   String
  role          HouseholdRole @default(MEMBER)
  createdAt     DateTime      @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedUser User      @relation("InvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([householdId, invitedUserId])
  @@index([invitedUserId, createdAt])
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  householdId  String
  createdById  String
  assignedToId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo User?     @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Virtual back-relations only; a task has zero or more expenses and images and no such columns.
  expenses Expense[]
  images   Image[]

  @@index([householdId, status])
  @@index([assignedToId])
}

// A money record for a household. It may point at the task it paid for, or stand
// alone (rent, utilities). Deleting the task keeps the expense and clears the link.
model Expense {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  category    ExpenseCategory @default(OTHER)
  householdId String
  paidById    String
  createdById String
  taskId      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paidBy    User      @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Restrict)
  createdBy User      @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  images    Image[]

  @@index([householdId, createdAt])
  @@index([taskId])
  @@index([paidById])
}

// A photo stored in Cloudinary and attached to exactly one task, expense or chat message; the
// migration adds a check constraint for that. Only the Cloudinary public ID is stored; URLs are
// derived from it. Deleting the parent deletes the row, and the service then removes the file
// from Cloudinary.
model Image {
  id           String   @id @default(uuid())
  householdId  String
  taskId       String?
  expenseId    String?
  messageId    String?
  publicId     String   @unique
  width        Int
  height       Int
  bytes        Int
  format       String
  uploadedById String
  createdAt    DateTime @default(now())

  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  expense    Expense?  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  message    Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([expenseId])
  @@index([messageId])
}

// A one-time code for resetting a forgotten password. Only the SHA-256 hash is stored; the code
// itself goes out by email. A code dies when used, when it expires, or after too many wrong tries.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id     String @id @default(uuid())
  userId String

  type    String
  title   String
  message String
  isRead  Boolean @default(false)

  // Navigation target. entityId is a task or expense ID depending on type; it
  // has no foreign key, so it may point at a record that was deleted later.
  householdId String?
  entityId    String?

  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

enum ConversationType {
  HOUSEHOLD
  DIRECT
}

enum ChatDeliveryKind {
  LIVE
  PUSH
}

enum ChatReceiptKind {
  DELIVERED
  READ
}

// One HOUSEHOLD key, or a canonical JSON pair of user IDs for a DIRECT chat.
model Conversation {
  id           String                    @id @default(uuid())
  householdId  String
  type         ConversationType
  key          String
  sequence     Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  household    Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  receipts     ChatReceipt[]

  @@unique([householdId, key])
  @@index([householdId, updatedAt, id])
}

// DIRECT rows define the immutable pair. HOUSEHOLD rows are only read/mute
// preferences: current HouseholdMember rows always control household access.
// clearedSequence is this user's "Clear chat" marker: messages at or below it are hidden
// from them only, and stay visible to everyone else.
// deliveredSequence is how far this user's phone has received messages. It is never behind
// lastReadSequence, because a message that was read must have arrived.
model ConversationParticipant {
  conversationId   String
  userId           String
  lastReadSequence Int          @default(0)
  deliveredSequence Int         @default(0)
  clearedSequence  Int          @default(0)
  muted            Boolean      @default(false)
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

// A log of the moments a user's delivered or read position moved forward. One row covers every
// message up to `sequence`, so reading ten messages at once is one row, not ten. The time a user
// read message N is their earliest READ row with sequence >= N, because positions only grow.
model ChatReceipt {
  id             String          @id @default(uuid())
  conversationId String
  userId         String
  kind           ChatReceiptKind
  sequence       Int
  createdAt      DateTime        @default(now())
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Also the index the "who read this message" lookup walks.
  @@unique([conversationId, kind, userId, sequence])
}

// `text` is the message, or a photo's caption. A photo message may have an empty caption; the
// service makes sure every message carries text, a photo, or both. `editedAt` is when the sender
// last changed the text, and null for a message never edited.
model Message {
  id              String            @id @default(uuid())
  conversationId  String
  senderId        String
  clientMessageId String
  sequence        Int
  text            String
  editedAt        DateTime?
  deletedAt       DateTime?
  deletedById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User              @relation(fields: [senderId], references: [id], onDelete: Restrict)
  deletedBy       User?             @relation("MessageDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  hiddenFor       MessageDeletion[]
  deliveries      ChatDelivery[]
  images          Image[]

  @@unique([conversationId, sequence])
  @@unique([conversationId, senderId, clientMessageId])
  @@index([senderId, createdAt])
}

// A per-user tombstone for "Delete for me". The message remains available to
// the other conversation members and can still be deleted for everyone later.
model MessageDeletion {
  messageId String
  userId    String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, createdAt])
}

model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  token      String         @unique
  platform   String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries ChatDelivery[]

  @@index([userId])
}

// Transactional outbox, one live job per recipient and push job per device.
// ticketId switches a PUSH job from sending to polling Expo receipts.
model ChatDelivery {
  id            String           @id @default(uuid())
  key           String           @unique
  kind          ChatDeliveryKind
  messageId     String
  userId        String
  deviceTokenId String?
  attempts      Int              @default(0)
  availableAt   DateTime         @default(now())
  leaseId       String?
  leaseUntil    DateTime?
  ticketId      String?
  ticketAt      DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  lastError     String?
  createdAt     DateTime         @default(now())
  message       Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken   DeviceToken?     @relation(fields: [deviceTokenId], references: [id], onDelete: Cascade)

  @@index([completedAt, failedAt, kind, availableAt])
}
