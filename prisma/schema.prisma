// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ExpenseCategory {
  GROCERIES
  UTILITIES
  RENT
  MAINTENANCE
  TRANSPORT
  HEALTH
  ENTERTAINMENT
  OTHER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  memberships       HouseholdMember[]
  createdHouseholds Household[]       @relation("HouseholdCreator")
  createdTasks      Task[]            @relation("TaskCreator")
  assignedTasks     Task[]            @relation("TaskAssignee")
  paidExpenses      Expense[]         @relation("ExpensePayer")
  createdExpenses   Expense[]         @relation("ExpenseCreator")
  uploadedImages    Image[]
}

model Household {
  createdById String
  createdBy   User     @relation("HouseholdCreator", fields: [createdById], references: [id], onDelete: Restrict)
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  members HouseholdMember[]
  tasks   Task[]
  expenses Expense[]
  images   Image[]

  @@unique([createdById, name])
}

model HouseholdMember {
  id          String        @id @default(uuid())
  userId      String
  householdId String
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  householdId  String
  createdById  String
  assignedToId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo User?     @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Virtual back-relations only; a task has zero or more expenses and images and no such columns.
  expenses Expense[]
  images   Image[]

  @@index([householdId, status])
  @@index([assignedToId])
}

// A money record for a household. It may point at the task it paid for, or stand
// alone (rent, utilities). Deleting the task keeps the expense and clears the link.
model Expense {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  category    ExpenseCategory @default(OTHER)
  householdId String
  paidById    String
  createdById String
  taskId      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paidBy    User      @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Restrict)
  createdBy User      @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  images    Image[]

  @@index([householdId, createdAt])
  @@index([taskId])
  @@index([paidById])
}

// A photo stored in Cloudinary and attached to exactly one task or one expense; the migration adds
// a check constraint for that. Only the Cloudinary public ID is stored; URLs are derived from it.
// Deleting the parent deletes the row, and the service then removes the file from Cloudinary.
model Image {
  id           String   @id @default(uuid())
  householdId  String
  taskId       String?
  expenseId    String?
  publicId     String   @unique
  width        Int
  height       Int
  bytes        Int
  format       String
  uploadedById String
  createdAt    DateTime @default(now())

  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  expense    Expense?  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([expenseId])
}
