# Copy to .env for local runs. On Render, add the same names under the service's Environment tab.

# Postgres. On Supabase use the Session pooler string (Connect > Direct > Session pooler), not
# the direct host, which is IPv6-only. Supabase signs its certificates with its own CA, so append
# ?sslmode=verify-full&sslrootcert=certs/supabase-root-2021-ca.crt to encrypt and verify the
# connection. Without sslmode the connection is not encrypted at all.
DATABASE_URL=

# Signs login tokens. Use a long random value, different from the local one.
JWT_SECRET=

# Browser origins allowed by CORS, comma-separated. Only the Expo web preview needs this; the
# Android app does not.
WEB_ORIGINS=http://localhost:8081,http://localhost:8082

# Web client ID(s) whose Google sign-in tokens the server accepts, comma-separated.
GOOGLE_CLIENT_IDS=

# cloudinary://<api key>:<api secret>@<cloud name>, from the Cloudinary dashboard.
CLOUDINARY_URL=

# Password reset mail. Set BREVO_API_KEY + MAIL_FROM (needed where SMTP is blocked, like Render),
# or EMAIL_USER + EMAIL_PASS for Gmail. With neither, mail is printed to the console.
BREVO_API_KEY=
MAIL_FROM=
EMAIL_USER=
EMAIL_PASS=

# Shown on /privacy as the address for account deletion requests. Optional.
CONTACT_EMAIL=

# Push notifications through Expo. EXPO_PUSH_ENABLED must be "true" to send.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_ENABLED=false
